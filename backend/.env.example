# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/infinshow
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/infinshow

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=infinshow
MINIO_SECURE=false

# InfiniSynapse AI API
INFINISYNAPSE_API_KEY=your-infini-synapse-api-key
INFINISYNAPSE_BASE_URL=https://app.infinisynapse.cn

# Rate Limits
RATE_LIMIT_GENERAL=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_TASK_CREATE=10/hour
